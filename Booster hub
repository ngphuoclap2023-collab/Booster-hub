local function ParseNumber(str)
    if not str then return 0 end
    str = tostring(str):lower():gsub(",", "")
    local num = tonumber(string.match(str, "[%d%.]+"))
    if not num then return 0 end
    if str:find("k") then return num * 1e3 end
    if str:find("m") then return num * 1e6 end
    if str:find("b") then return num * 1e9 end
    if str:find("t") then return num * 1e12 end
    if str:find("qd") then return num * 1e15 end
    if str:find("qn") then return num * 1e18 end
    if str:find("sx") then return num * 1e21 end
    return num
end

-- Hàm tự động tìm Base (SpawnLocation hoặc khu vực Safe)
local function FindAutoBase()
    -- 1. Tìm SpawnLocation trước (chuẩn nhất)
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("SpawnLocation") then
            return v.CFrame + Vector3.new(0, 3, 0)
        end
    end
    -- 2. Nếu không có, tìm Part/Model có tên chứa Base, Safe, Home
    for _, v in pairs(Workspace:GetDescendants()) do
        local name = v.Name:lower()
        if (name:find("base") or name:find("safezone") or name:find("home")) and (v:IsA("Part") or v:IsA("Model")) then
            local pos = (v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and v.HumanoidRootPart.Position) or (v:IsA("Part") and v.Position)
            if pos then return CFrame.new(pos + Vector3.new(0, 5, 0)) end
        end
    end
    return nil
end

