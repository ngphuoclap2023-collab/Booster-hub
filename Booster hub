-- ====================== 🚀 TĂNG FPS NÂNG CAO ======================
local savedLighting = {
    shadows    = Lighting.GlobalShadows,
    fogEnd     = Lighting.FogEnd,
    brightness = Lighting.Brightness,
    shadowSoft = Lighting.ShadowSoftness,
}

local fpsCleanupConn

local function deepFPS()
    -- 1) Graphics & Render
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
    end)
    pcall(function()
        game:GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel1
    end)

    -- 2) Lighting
    Lighting.GlobalShadows    = false
    Lighting.FogEnd           = 1e5
    Lighting.Brightness       = 2
    Lighting.EnvironmentDiffuseScale  = 0
    Lighting.EnvironmentSpecularScale = 0
    pcall(function() Lighting.ShadowSoftness = 0 end)
    -- Xóa hiệu ứng post-processing
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("BloomEffect")
        or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect")
        or v:IsA("ColorCorrectionEffect") or v:IsA("Atmosphere") then
            v.Enabled = false
        end
    end

    -- 3) Quét toàn workspace 1 lần
    for _, v in ipairs(workspace:GetDescendants()) do
        -- Tắt particle nặng
        if v:IsA("ParticleEmitter") or v:IsA("Smoke")
        or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        -- Đổi Neon -> SmoothPlastic
        elseif v:IsA("BasePart") then
            if v.Material == Enum.Material.Neon then
                v.Material = Enum.Material.SmoothPlastic
            end
            -- Tắt texture/decal
            if v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            end
        -- Tắt Terrain detail
        elseif v:IsA("Terrain") then
            pcall(function()
                v.WaterWaveSize   = 0
                v.WaterWaveSpeed  = 0
                v.WaterReflectance = 0
                v.WaterTransparency = 1
                v.Decoration = false
            end)
        end
    end

    -- 4) Auto-cleanup: effect mới spawn sau khi bật FPS
    if fpsCleanupConn then fpsCleanupConn:Disconnect() end
    fpsCleanupConn = workspace.DescendantAdded:Connect(function(v)
        if not states.fps then return end
        if v:IsA("ParticleEmitter") or v:IsA("Smoke")
        or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        elseif v:IsA("BasePart") and v.Material == Enum.Material.Neon then
            v.Material = Enum.Material.SmoothPlastic
        end
    end)
end

local function restoreFPS()
    if fpsCleanupConn then fpsCleanupConn:Disconnect(); fpsCleanupConn = nil end
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level08
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
    end)
    Lighting.GlobalShadows    = savedLighting.shadows
    Lighting.FogEnd           = savedLighting.fogEnd
    Lighting.Brightness       = savedLighting.brightness
    Lighting.EnvironmentDiffuseScale  = 1
    Lighting.EnvironmentSpecularScale = 1
    pcall(function() Lighting.ShadowSoftness = savedLighting.shadowSoft end)
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("BlurEffect") or v:IsA("BloomEffect")
        or v:IsA("DepthOfFieldEffect") or v:IsA("SunRaysEffect")
        or v:IsA("ColorCorrectionEffect") or v:IsA("Atmosphere") then
            v.Enabled = true
        end
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Smoke")
        or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = true
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 0
        end
    end
end

local function setFPS(on)
    states.fps = on
    if on then pcall(deepFPS) else pcall(restoreFPS) end
end

-- ====================== 📡 GIẢM PING NÂNG CAO ======================
local pingCleanupConn

local function deepPing()
    -- 1) Tắt hiệu ứng network nặng
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Trail") or v:IsA("Beam") then
            v.Enabled = false
        elseif v:IsA("Sound") then
            v.Playing = false
            v.Volume = 0
        end
    end

    -- 2) Tắt animation của người chơi khác (giảm replication)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local anim = hum and hum:FindFirstChildOfClass("Animator")
            if anim then
                for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
                    tr:Stop()
                end
            end
        end
    end

    -- 3) Physics & Network
    pcall(function() Lighting.ShadowSoftness = 0 end)
    pcall(function() settings().Physics.AllowSleep = true end)
    pcall(function() settings().Physics.PhysicsEnvironmentalThrottle =
        Enum.EnviromentalPhysicsThrottle.DefaultAuto end)
    pcall(function() settings().Network.IncomingReplicationLag = 0 end)

    -- 4) Auto-cleanup effect mới
    if pingCleanupConn then pingCleanupConn:Disconnect() end
    pingCleanupConn = workspace.DescendantAdded:Connect(function(v)
        if not states.ping then return end
        if v:IsA("Trail") or v:IsA("Beam") then
            v.Enabled = false
        elseif v:IsA("Sound") then
            v.Volume = 0
        end
    end)
end

local function restorePing()
    if pingCleanupConn then pingCleanupConn:Disconnect(); pingCleanupConn = nil end
    pcall(function()
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Trail") or v:IsA("Beam") then
                v.Enabled = true
            elseif v:IsA("Sound") then
                v.Volume = 0.5
            end
        end
        Lighting.ShadowSoftness = 0.2
    end)
end

local function setPing(on)
    states.ping = on
    if on then pcall(deepPing) else pcall(restorePing) end
end

-- ====================== ⛏️ X2 SWING (0.02) ======================
local swingConn
local function getPickaxe()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Tool")
end

local function applySwing(on)
    if swingConn then swingConn:Disconnect(); swingConn = nil end
    if not on then return end
    swingConn = RunService.Heartbeat:Connect(function()
        local tool = getPickaxe()
        if not tool then return end
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") then
                local n = v.Name:lower()
                if n:find("cooldown") or n:find("delay")
                or n:find("wait") or n:find("rate") or n:find("swing") then
                    v.Value = 0.02
                end
            end
        end
        for _, attr in ipairs(tool:GetAttributes()) do
            local n = attr:lower()
            if n:find("cooldown") or n:find("delay")
            or n:find("rate") or n:find("swing") then
                pcall(function() tool:SetAttribute(attr, 0.02) end)
            end
        end
        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                local an = tr.Animation and tr.Animation.Name:lower() or ""
                if an:find("swing") or an:find("pick")
                or an:find("hit") or an:find("mine") then
                    tr:AdjustSpeed(4)
                end
            end
        end
    end)
end

