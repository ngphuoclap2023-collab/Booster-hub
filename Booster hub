-- Hàm tạo nút Toggle
local function CreateToggle(parent, text, desc, order, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, 0, 0, 55)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.LayoutOrder = order
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local title = Instance.new("TextLabel")
    title.Parent = frame
    title.Size = UDim2.new(0.75, 0, 0, 25)
    title.Position = UDim2.new(0, 10, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = text
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left

    local descLabel = Instance.new("TextLabel")
    descLabel.Parent = frame
    descLabel.Size = UDim2.new(0.75, 0, 0, 20)
    descLabel.Position = UDim2.new(0, 10, 0, 28)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = desc
    descLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextSize = 11
    descLabel.TextXAlignment = Enum.TextXAlignment.Left

    local btn = Instance.new("TextButton")
    btn.Parent = frame
    btn.Size = UDim2.new(0, 60, 0, 28)
    btn.Position = UDim2.new(1, -70, 0.5, -14)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = "TẮT"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        local isOn = btn.Text == "TẮT"
        callback(isOn)
        if isOn then
            btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            btn.Text = "BẬT"
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            btn.Text = "TẮT"
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
end

-- Hàm tạo Ô nhập liệu
local function CreateInput(parent, text, defaultVal, order, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, 0, 0, 45)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.LayoutOrder = order
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left

    local input = Instance.new("TextBox")
    input.Parent = frame
    input.Size = UDim2.new(0, 80, 0, 28)
    input.Position = UDim2.new(1, -90, 0.5, -14)
    input.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    input.Text = tostring(defaultVal)
    input.TextColor3 = Color3.fromRGB(0, 255, 255)
    input.Font = Enum.Font.GothamBold
    input.TextSize = 12
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 6)

    input.FocusLost:Connect(function()
        callback(input.Text)
    end)
end

-- ================= KHU VỰC TÍNH NĂNG =================

CreateToggle(ScrollFrame, "Khởi Động Nhanh (Startup Boost)", "Giảm đồ họa tối đa ngay khi bật, xóa sương mù", 1, function(v)
    States.StartupBoost = v
    if v then
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
    else
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level08
        Lighting.GlobalShadows = true
        Lighting.FogEnd = 100000
    end
end)

CreateToggle(ScrollFrame, "Ẩn Giao Diện Túi Đồ (No Backpack)", "Ẩn UI ba lô và các nút thừa của game", 2, function(v)
    States.NoBackpack = v
    local backpack = PlayerGui:FindFirstChild("Backpack")
    if backpack then
        backpack.Enabled = not v
    end
end)

CreateToggle(ScrollFrame, "Tăng Cường FPS (Xóa Hiệu Ứng)", "Xóa hạt, đèn, pet người khác, hiệu ứng trứng", 3, function(v)
    States.FPSBoost = v
    if v then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("PointLight") or obj:IsA("SpotLight") then
                if obj.Enabled then
                    obj.Enabled = false
                    table.insert(SavedVisuals, obj)
                end
            end
        end
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, obj in pairs(plr.Character:GetDescendants()) do
                    if obj:IsA("Model") and (obj.Name:lower():find("pet") or obj.Name:lower():find("guard")) then
                        obj.Parent = nil
                    end
                end
            end
        end
    else
        for _, obj in pairs(SavedVisuals) do
            if obj and obj.Parent then obj.Enabled = true end
        end
        table.clear(SavedVisuals)
    end
end)

