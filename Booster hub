task.spawn(function()
    while task.wait() do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            if featureStates.Swing then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and (tool.Name:lower():find("pick") or tool.Name:lower():find("pickaxe")) then
                    tool:Activate()
                    task.wait(0.05)
                end
            end
            if featureStates.AutoDiamond then
                local range = tonumber(RangeInput.Text) or 500
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") and (v.Name:lower():find("diamond") or v.Name:lower():find("gem") or v.Name:lower():find("kim cương")) then
                        if (v.Position - hrp.Position).Magnitude <= range then
                            v.CFrame = hrp.CFrame
                        end
                    end
                end
            end
            if featureStates.NoClip then
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                end
            end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if featureStates.InfJump then
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        end
    end
end)
