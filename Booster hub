-- ================= LOGIC QUÉT & LỌC =================
local function HasGoodWeather()
    for _, weather in pairs(WeatherList) do
        if Workspace:FindFirstChild(weather) or ReplicatedStorage:FindFirstChild(weather) then return true end
    end
    return false
end

local function GetPetStat(petModel, statName)
    for _, v in pairs(petModel:GetDescendants()) do
        if v:IsA("ValueBase") and v.Name:lower():find(statName:lower()) then
            return ParseNumber(v.Value)
        end
    end
    return nil
end

local function PassesPetFilter(petModel)
    if filters.AlwaysStealMutations then
        if petModel.Name:lower():find("mutation") or petModel.Name:lower():find("mutated") then return true end
    end

    local gen = GetPetStat(petModel, "generation") or GetPetStat(petModel, "gen") or GetPetStat(petModel, "income") or GetPetStat(petModel, "power") or GetPetStat(petModel, "damage")
    local weight = GetPetStat(petModel, "weight")

    if gen and gen > 0 then
        if gen < filters.MinGen then return false end
    end

    if weight and weight > 0 then
        if weight < filters.MinWeight or weight > filters.MaxWeight then return false end
    end

    return true
end

local function ClickEquipBest()
    for _, gui in pairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") and gui.Text:lower():find("equip best") then
            firesignal(gui.MouseButton1Click)
            return true
        end
    end
    return false
end

local function GetTargetEgg()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    
    local bestEgg = nil
    local bestValue = -math.huge

    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "Egg" and (v:IsA("Model") or v:IsA("BasePart")) then
            local passFilter = true
            if filters.EggRarity ~= "" and not v.Name:lower():find(filters.EggRarity:lower()) then passFilter = false end
            if filters.EggArea ~= "" and not v.Parent.Name:lower():find(filters.EggArea:lower()) then passFilter = false end
            
            if passFilter then
                local pos = (v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and v.HumanoidRootPart.Position) or (v:IsA("BasePart") and v.Position)
                if pos then
                    if featureStates.FarmMode == "Cuối Map" then
                        if pos.Z > bestValue then bestValue = pos.Z; bestEgg = v end
                    else
                        local dist = (pos - hrp.Position).Magnitude
                        if -dist > bestValue then bestValue = -dist; bestEgg = v end
                    end
                end
            end
        end
    end
    return bestEgg
end

local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local distance = (targetPos - hrp.Position).Magnitude
        if distance > 5 then
            local tween = TweenService:Create(hrp, TweenInfo.new(distance / 150, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
            tween:Play(); tween.Completed:Wait()
        end
    end
end

-- ================= VÒNG LẶP CHÍNH =================
task.spawn(function()
    while task.wait() do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            
            if featureStates.AutoEquipBest then
                if tick() % 3 < 1 then ClickEquipBest() end
            end

            if featureStates.AutoFarm then
                local canFarm = true
                if featureStates.WeatherOnly then canFarm = HasGoodWeather() end

                if canFarm then
                    local targetEgg = GetTargetEgg()
                    if targetEgg then
                        local eggPos = (targetEgg:IsA("Model") and targetEgg:FindFirstChild("HumanoidRootPart") and targetEgg.HumanoidRootPart.Position) or (targetEgg:IsA("BasePart") and targetEgg.Position)
                        if eggPos then
                            TweenTo(eggPos + Vector3.new(0, 3, 0))
                            local tool = char:FindFirstChildOfClass("Tool")
                            if tool and (tool.Name:lower():find("pick") or tool.Name:lower():find("pickaxe")) then tool:Activate() end
                        end
                    end
                end
            end

            if featureStates.InstantSteal then
                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local parent = prompt.Parent
                        if parent and (parent.Name:lower():find("pet") or parent.Name:lower():find("egg")) then
                            if PassesPetFilter(parent) then
                                fireproximityprompt(prompt)
                                task.wait(0.2)
                                
                                if featureStates.TeleOnSteal then
                                    -- Nếu chưa có SavedBasePos, tự động tìm Base
                                    if not featureStates.SavedBasePos then
                                        featureStates.SavedBasePos = FindAutoBase()
                                    end
                                    -- Nếu tìm thấy Base, tele về
                                    if featureStates.SavedBasePos then
                                        local currentChar = LocalPlayer.Character
                                        if currentChar and currentChar:FindFirstChild("HumanoidRootPart") then
                                            currentChar.HumanoidRootPart.CFrame = featureStates.SavedBasePos
                                        end
                                    end
                                end
                                
                                if featureStates.AutoEquipBest then ClickEquipBest() end
                            end
                        end
                    end
                end
            end

            if featureStates.Swing and not featureStates.AutoFarm then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and (tool.Name:lower():find("pick") or tool.Name:lower():find("pickaxe")) then
                    tool:Activate(); task.wait(0.05)
                end
            end

            if featureStates.NoClip then
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                end
            end
        end
    end
end)

UserInputService.JumpRequest:Connect(function()
    if featureStates.InfJump then
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping") end
    end
end)
