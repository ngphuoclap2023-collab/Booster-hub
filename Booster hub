    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(70, 70, 90)
    s.Thickness = 1.5
    return b, s
end

local function setState(btn, stroke, on)
    TweenService:Create(btn, TweenInfo.new(0.18), {
        BackgroundColor3 = on and ON_COLOR or OFF_COLOR,
        TextColor3       = on and ON_TEXT  or OFF_TEXT
    }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.18), {
        Color = on and Color3.fromRGB(0, 255, 160) or Color3.fromRGB(70, 70, 90)
    }):Play()
end

