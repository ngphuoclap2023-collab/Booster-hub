-- ═══════════ KHỞI CHẠY GIAO DIỆN ═══════════
local function launchUI()
    -- Thử nhiều API khác nhau tuỳ phiên bản Delta
    if gg.newWebView then
        gg.newWebView(UI_HTML)
    elseif delta and delta.newWebView then
        delta.newWebView(UI_HTML)
    elseif webview and webview.show then
        webview.show(UI_HTML)
    else
        return false
    end
    return true
end

if launchUI() then
    gg.toast("🚀 Booster Hub đã khởi động!")
else
    -- ══════ MENU DỰ PHÒNG NẾU WEBVIEW KHÔNG KHẢ DỤNG ══════
    gg.toast("⚠️ Dùng menu dự phòng")
    local running = true
    while running do
        if gg.isVisible() then
            gg.setVisible(false)

            local list = {
                (FPS_ON  and "🟢 " or "🔴 ") .. "Tăng FPS: "  .. (FPS_ON  and "ON" or "OFF"),
                (PING_ON and "🟢 " or "🔴 ") .. "Giảm Ping: " .. (PING_ON and "ON" or "OFF"),
                "❌ Đóng Menu"
            }
            local c = gg.choice(list, nil, "═══ BOOSTER HUB ═══")

            if c == 1 then FPS_ON  = setFPSBoost(not FPS_ON)  end
            if c == 2 then PING_ON = setPingBoost(not PING_ON) end
            if c == 3 or c == nil then running = false end
        end
        gg.sleep(100)
    end
end
