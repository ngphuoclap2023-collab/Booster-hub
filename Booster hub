-- ============ HÀM TẠO ĐỐI TƯỢNG UI (có bo góc) ============
local function createRoundFrame(parent, size, pos, radius, color, strokeColor)
    local frame = Instance.new("Frame")
    frame.Size = size
    frame.Position = pos
    frame.BackgroundColor3 = color
    frame.BorderSizePixel = 0
    frame.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 10)
    corner.Parent = frame

    if strokeColor then
        local stroke = Instance.new("UIStroke")
        stroke.Color = strokeColor
        stroke.Thickness = 1
        stroke.Parent = frame
    end
    return frame
end

local function createRoundButton(parent, size, pos, radius, color, text, callback)
    local btn = createRoundFrame(parent, size, pos, radius, color, COLOR.OUTLINE)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or ""
    label.TextColor3 = COLOR.TEXT
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.Parent = btn

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingRight = UDim.new(0, 8)
    padding.Parent = label

    if callback then
        btn.MouseButton1Click:Connect(callback)
    end

    return btn, label
end

