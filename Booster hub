-- ====================== TOGGLE + DRAG ======================
toggleBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
end)

local dragging, dragStart, startPos
toggleBtn.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = i.Position
        startPos  = toggleBtn.Position
    end
end)

UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
    or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dragStart
        toggleBtn.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ====================== TẠO NÚT ======================
local ON_COLOR  = Color3.fromRGB(0, 190, 110)
local OFF_COLOR = Color3.fromRGB(35, 35, 50)
local ON_TEXT   = Color3.fromRGB(255, 255, 255)
local OFF_TEXT  = Color3.fromRGB(200, 200, 210)

local function createBtn(text)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 72, 0, 78)
    b.BackgroundColor3 = OFF_COLOR
    b.TextColor3 = OFF_TEXT
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.TextWrapped = true
    b.AutoButtonColor = false
    b.Parent = container

    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(70, 70, 90)
    s.Thickness = 1.5
    return b, s
end

local function setState(btn, stroke, on)
    local targetBG = on and ON_COLOR or OFF_COLOR
    local targetTx = on and ON_TEXT  or OFF_TEXT
    local targetSt = on and Color3.fromRGB(0, 255, 160) or Color3.fromRGB(70, 70, 90)
    TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = targetBG}):Play()
    TweenService:Create(btn, TweenInfo.new(0.18), {TextColor3 = targetTx}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.18), {Color = targetSt}):Play()
end

-- ====================== STATE ======================
local states = {
    fps   = false,
    ping  = false,
    x2    = false,
}

-- ====================== CHỨC NĂNG TĂNG FPS ======================
local savedLighting = {
    shadows   = Lighting.GlobalShadows,
    fogEnd    = Lighting.FogEnd,
    brightness= Lighting.Brightness,
}

local function setFPS(on)
    states.fps = on
    if on then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e5
            Lighting.Brightness = 2
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Smoke")
                or v:IsA("Fire") or v:IsA("Sparkles") then
                    v.Enabled = false
                elseif v:IsA("BasePart") and v.Material == Enum.Material.Neon then
                    v.Material = Enum.Material.SmoothPlastic
                end
            end
        end)
    else
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level08
            Lighting.GlobalShadows = savedLighting.shadows
            Lighting.FogEnd = savedLighting.fogEnd
            Lighting.Brightness = savedLighting.brightness
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Smoke")
                or v:IsA("Fire") or v:IsA("Sparkles") then
                    v.Enabled = true
                end
            end
        end)
    end
end

-- ====================== CHỨC NĂNG GIẢM PING ======================
local function setPing(on)
    states.ping = on
    if on then
        pcall(function()
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Trail") or v:IsA("Beam") then
                    v.Enabled = false
                end
            end
            pcall(function() Lighting.ShadowSoftness = 0 end)
            pcall(function() settings().Physics.AllowSleep = true end)
        end)
    else
        pcall(function()
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("Trail") or v:IsA("Beam") then
                    v.Enabled = true
                end
            end
            pcall(function() Lighting.ShadowSoftness = 0.2 end)
        end)
    end
end

-- ====================== X2 SWING (cooldown = 0.01) ======================
local swingConn

local function getPickaxe()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildOfClass("Tool")
end

local function applySwing(on)
    if swingConn then swingConn:Disconnect(); swingConn = nil end
    if not on then return end

    swingConn = RunService.Heartbeat:Connect(function()
        local tool = getPickaxe()
        if not tool then return end

        -- 1) Ép cooldown NumberValue về 0.01
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("NumberValue") then
                local n = v.Name:lower()
                if n:find("cooldown") or n:find("delay")
                or n:find("wait") or n:find("rate") or n:find("swing") then
                    v.Value = 0.01
                end
            end
        end

        -- 1b) Ép cooldown dạng Attribute (nếu game dùng attribute)
        for _, attr in ipairs(tool:GetAttributes()) do
            local n = attr:lower()
            if n:find("cooldown") or n:find("delay")
            or n:find("rate") or n:find("swing") then
                pcall(function() tool:SetAttribute(attr, 0.01) end)
            end
        end

        -- 2) Tăng tốc animation (5x cho khớp 0.01)
        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do
                local an = tr.Animation and tr.Animation.Name:lower() or ""
                if an:find("swing") or an:find("pick")
                or an:find("hit") or an:find("mine") then
                    tr:AdjustSpeed(5)
                end
            end
        end
    end)
end

