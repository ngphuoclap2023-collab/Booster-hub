-- ================= VÒNG LẶP XỬ LÝ LOGIC =================
-- Xử lý Swing Pickaxe và Auto Diamond
task.spawn(function()
    while task.wait() do
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            
            -- 1. X2 Swing Pickaxe
            if featureStates.Swing then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool and (tool.Name:lower():find("pick") or tool.Name:lower():find("pickaxe")) then
                    -- Kích hoạt tool liên tục với tốc độ cực cao
                    tool:Activate()
                    task.wait(0.05) -- Chờ 0.05s để tránh bị game kick vì spam quá nhanh
                end
            end
            
            -- 2. Auto Hút Kim Cương
            if featureStates.AutoDiamond then
                local range = tonumber(RangeInput.Text) or 500
                for _, v in pairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") and (v.Name:lower():find("diamond") or v.Name:lower():find("gem") or v.Name:lower():find("kim cương")) then
                        local distance = (v.Position - hrp.Position).Magnitude
                        if distance <= range then
                            -- Teleport kim cương thẳng vào người người chơi
                            v.CFrame = hrp.CFrame
                        end
                    end
                end
            end
            
            -- 3. No Clip
            if featureStates.NoClip then
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then
                        v.CanCollide = false
                    end
                end
            end
        end
    end
end)

