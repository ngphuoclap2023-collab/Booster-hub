-- ═══════════════════════════════════════════════════
--   BOOSTER HUB v1.1 (FIXED)
--   Game: Break and Steal an Egg
--   Platform: Delta Android Executor
-- ═══════════════════════════════════════════════════

gg.setVisible(false)
gg.clearResults()
gg.sleep(200)

-- ═══════════ TRẠNG THÁI ═══════════
local FPS_ON  = false
local PING_ON = false

-- Lưu giá trị GỐC để restore CHÍNH XÁC (fix Lỗi 2)
local fpsSaved = {}

-- ═══════════ CHỨC NĂNG 1: TĂNG FPS ═══════════
local function setFPSBoost(state)
    if state then
        if #fpsSaved > 0 then
            gg.toast("ℹ️ FPS Boost đã bật rồi")
            return true
        end

        gg.toast("⚡ Đang tìm FPS cap...")
        fpsSaved = {}
        gg.setRanges(gg.REGION_OTHER | gg.REGION_C_ALLOC | gg.REGION_ANONYMOUS | gg.REGION_JAVA_HEAP)

        -- ── Ưu tiên FLOAT (Unity engine) ──
        for _, cap in ipairs({"30.0", "60.0"}) do
            gg.searchNumber(cap, gg.TYPE_FLOAT)
            local n = gg.getResultsCount()
            if n > 0 and n <= 300 then
                local res   = gg.getResults(n)
                local edits = {}
                for _, r in ipairs(res) do
                    table.insert(fpsSaved, {address = r.address, value = r.value, flags = r.flags})
                    table.insert(edits,   {address = r.address, value = 120.0,  flags = r.flags})
                end
                gg.setValues(edits)
            end
            gg.clearResults()
        end

        -- ── Fallback DWORD ──
        if #fpsSaved == 0 then
            for _, cap in ipairs({"30", "60"}) do
                gg.searchNumber(cap, gg.TYPE_DWORD)
                local n = gg.getResultsCount()
                if n > 0 and n <= 300 then
                    local res   = gg.getResults(n)
                    local edits = {}
                    for _, r in ipairs(res) do
                        table.insert(fpsSaved, {address = r.address, value = r.value, flags = r.flags})
                        table.insert(edits,   {address = r.address, value = 120,    flags = r.flags})
                    end
                    gg.setValues(edits)
                end
                gg.clearResults()
            end
        end

        if #fpsSaved > 0 then
            gg.toast("✅ FPS Boost ON (" .. #fpsSaved .. " giá trị)")
            return true
        else
            gg.toast("⚠️ Không tìm thấy FPS cap — game có thể dùng cơ chế khác")
            return false
        end
    else
        -- Restore ĐÚNG các địa chỉ đã lưu (fix Lỗi 2)
        if #fpsSaved > 0 then
            gg.setValues(fpsSaved)
            fpsSaved = {}
        end
        gg.toast("❌ FPS Boost OFF")
        return false
    end
end

-- ═══════════ CHỨC NĂNG 2: GIẢM PING ═══════════
local function setPingBoost(state)
    if state then
        gg.toast("📡 Đang tối ưu Ping (client-side)...")
        pcall(function()
            os.execute("sync; echo 3 > /proc/sys/vm/drop_caches 2>/dev/null")
        end)
        gg.toast("✅ Ping Boost ON (hiệu quả hạn chế)")
        return true
    else
        gg.toast("❌ Ping Boost OFF")
        return false
    end
end

-- ═══════════ MENU LOOP (chạy được 100% trên Delta) ═══════════
gg.toast("🚀 Booster Hub đã khởi động!")
gg.setVisible(false)

local running = true
while running do
    if gg.isVisible() then
        gg.setVisible(false)

        local list = {
            "⚡ Tăng FPS        " .. (FPS_ON  and "🟢 ON" or "🔴 OFF"),
            "📡 Giảm Ping      " .. (PING_ON and "🟢 ON" or "🔴 OFF"),
            "───────── Đóng ─────────"
        }
        local c = gg.choice(list, nil, "═══ ⚡ BOOSTER HUB ⚡ ═══")

        if c == 1 then
            FPS_ON = setFPSBoost(not FPS_ON)
        elseif c == 2 then
            PING_ON = setPingBoost(not PING_ON)
        elseif c == 3 or c == nil then
            running = false
        end
    end
    gg.sleep(100)
end

gg.toast("👋 Booster Hub đã đóng")
