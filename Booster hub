-- Hàm tạo Toggle Button (Có đổi màu)
local function CreateToggle(parent, text, order)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Text = text .. " [TẮT]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.LayoutOrder = order
    btn.BorderSizePixel = 0
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 6)
    
    local padding = Instance.new("UIPadding", parent)
    padding.PaddingBottom = UDim.new(0, 5)
    
    return btn
end

-- Hàm cập nhật trạng thái nút
local function UpdateBtnState(btn, isOn, name)
    if isOn then
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0) -- Màu xanh lá khi BẬT
        btn.Text = name .. " [BẬT]"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50) -- Màu xám khi TẮT
        btn.Text = name .. " [TẮT]"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

