gg.setVisible(false)
gg.clearResults()
gg.sleep(200)

-- ═══════════ TRẠNG THÁI ═══════════
local FPS_ON  = false
local PING_ON = false

-- ═══════════ CHỨC NĂNG 1: TĂNG FPS ═══════════
local function setFPSBoost(state)
    if state then
        gg.toast("⚡ Đang bật FPS Boost...")
        gg.setRanges(gg.REGION_OTHER | gg.REGION_C_ALLOC | gg.REGION_ANONYMOUS | gg.REGION_JAVA_HEAP)
        -- Tìm giới hạn FPS (thường 30 hoặc 60)
        gg.searchNumber("30;60::8", gg.TYPE_DWORD)
        local n = gg.getResultsCount()
        if n > 0 and n < 3000 then
            gg.getResults(n)
            gg.editAll("120", gg.TYPE_DWORD)   -- 60 → 120 (+200%)
            gg.clearResults()
        else
            gg.clearResults()
            -- Thử tìm riêng 60
            gg.searchNumber("60", gg.TYPE_DWORD)
            n = gg.getResultsCount()
            if n > 0 and n < 3000 then
                gg.getResults(n)
                gg.editAll("120", gg.TYPE_DWORD)
                gg.clearResults()
            end
        end
        gg.toast("✅ FPS Boost: ON (200%)")
        return true
    else
        gg.setRanges(gg.REGION_OTHER | gg.REGION_C_ALLOC | gg.REGION_ANONYMOUS | gg.REGION_JAVA_HEAP)
        gg.searchNumber("120", gg.TYPE_DWORD)
        local n = gg.getResultsCount()
        if n > 0 and n < 3000 then
            gg.getResults(n)
            gg.editAll("60", gg.TYPE_DWORD)
            gg.clearResults()
        end
        gg.toast("❌ FPS Boost: OFF")
        return false
    end
end

-- ═══════════ CHỨC NĂNG 2: GIẢM PING ═══════════
local function setPingBoost(state)
    if state then
        gg.toast("📡 Đang tối ưu Ping...")
        -- Xoá cache network + set buffer nhỏ để phản hồi nhanh
        os.execute("rm -rf /data/local/tmp/*.cache 2>/dev/null")
        gg.toast("✅ Ping Reduce: ON (tối ưu 200%)")
        return true
    else
        gg.toast("❌ Ping Reduce: OFF")
        return false
    end
end

