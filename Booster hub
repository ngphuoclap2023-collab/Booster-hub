local function CreateToggle(parent, text, order)
    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Text = text .. " [TẮT]"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    btn.LayoutOrder = order
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    return btn
end

local function UpdateBtnState(btn, isOn, name)
    if isOn then
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        btn.Text = name .. " [BẬT]"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.Text = name .. " [TẮT]"
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

local function CreateInput(parent, labelText, defaultText, order, callback)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = UDim2.new(1, 0, 0, 28)
    frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    frame.LayoutOrder = order
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.Size = UDim2.new(0.5, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.Gotham
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Position = UDim2.new(0, 5, 0, 0)

    local input = Instance.new("TextBox")
    input.Parent = frame
    input.Size = UDim2.new(0.45, 0, 0.7, 0)
    input.Position = UDim2.new(0.52, 0, 0.15, 0)
    input.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    input.Text = tostring(defaultText)
    input.TextColor3 = Color3.fromRGB(0, 255, 255)
    input.Font = Enum.Font.GothamBold
    input.TextSize = 11
    Instance.new("UICorner", input).CornerRadius = UDim.new(0, 4)

    input.FocusLost:Connect(function()
        if callback then callback(input.Text) end
    end)
    return input
end

